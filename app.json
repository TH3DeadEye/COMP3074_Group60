{
  "expo": {
    "name": "DUMPLO Driver",
    "slug": "COMP3074_Group60",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DUMPLO Driver uses your location to show you on the route map and estimate the drive to your next stop."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.group60.dumplodriver"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DUMPLO Driver uses your location to show you on the route map and estimate the drive to your next stop."
        }
      ]
    ],
    "scheme": "dumplodriver",
    "experiments": {
      "typedRoutes": true
    }
  }
}
